# Eastmans Developments - hosting rules (Apache / LiteSpeed, as used by Hostinger)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: send www to the bare domain, preserving path and query.
  RewriteCond %{HTTP_HOST} ^www\.eastmans\.london$ [NC]
  RewriteRule ^(.*)$ https://eastmans.london/$1 [R=301,L]

  # Keep the existing HTTP to HTTPS upgrade.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://eastmans.london/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Fingerprint-free assets change with the deploy, so keep HTML fresh and
  # cache static assets hard.
  <FilesMatch "\.(woff2|png|svg|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml
</IfModule>

AddType font/woff2 .woff2
