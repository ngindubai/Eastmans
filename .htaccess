# Eastmans Developments - hosting rules (Apache / LiteSpeed, as used by Hostinger)

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: send www to the bare domain, preserving path and query.
  RewriteCond %{HTTP_HOST} ^www\.eastmans\.london$ [NC]
  RewriteRule ^(.*)$ https://eastmans.london/$1 [R=301,L]

  # Keep the existing HTTP to HTTPS upgrade.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://eastmans.london/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # Assets are referenced with a ?v= content hash from index.html, so caching
  # them hard is safe: a changed file gets a new URL. HTML stays fresh so the
  # new hashes are picked up on the next visit.
  <FilesMatch "\.(woff2|png|svg|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/xml
</IfModule>

AddType font/woff2 .woff2
